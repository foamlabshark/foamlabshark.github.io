  "statement": {
    "physical": [
      "西藏高原的大气压力随海拔变化，压力差对流体设备的运行有着直观影响。把关注点转向密闭液体储罐，当储罐突然与较低压力的出口连通时，内部压力又会怎样变化？本关研究卸压引起的压力扰动传播。"
    ],
    "geometry": [
      "3,725 个单元。网格由本页原始文件和运行步骤生成，所有长度使用 SI 米。",
      "在示意图中核对边界名称；初始化文件和附带几何可在完整原始目录中查看。",
      "网格外包络沿 x、y、z 的长度依次为 0.15 × 0.3 × 0.02 m。点击图可放大查看实际 patch 名称及位置；同一边界可包含多处面。"
    ],
    "properties": [
      "constant/thermodynamicProperties 中 rho0 取 1000 kg/m³。",
      "constant/thermodynamicProperties 中 p0 取 100000 Pa。",
      "constant/thermodynamicProperties 中 psi 取 4.54e-07。",
      "constant/transportProperties 中 mu 取 0.001 Pa·s。"
    ],
    "boundary": [
      "0/U 中的场为速度，单位 m/s；填写七个基本量纲指数。",
      "0/U 的初始内部场均匀，数值为 (0, 0, 0)（采用该场的 SI 单位）。",
      "0/U 这一段对应的网格边界名是 outerWall；从示意图的边界分组中选择，保持大小写一致。",
      "0/p 中的场为压力，单位 Pa；填写七个基本量纲指数。",
      "0/p 的初始内部场均匀，数值为 1e+07（采用该场的 SI 单位）。",
      "0/p 的 outerWall：边界法向梯度为零。",
      "0/p 的 axis：采用平面对称条件。",
      "0/p 的 nozzle：直接指定边界上的场值，不从内部单元外推。",
      "0/p 的 nozzle 边界指定值为 0（采用该场的 SI 单位）。",
      "0/p 的 back：前后面不参与求解，为二维空边界。"
    ],
    "control": [
      "求解器使用 sonicLiquidFoam。",
      "终止时间/迭代编号为 0.0001。",
      "初始时间步（稳态求解时为迭代步长）为 5e-07。",
      "结果写出间隔（单位由文件中的 writeControl 决定）为 20。"
    ],
    "numerics": [
      "system/fvSchemes 中 ddtSchemes/default 取 Euler。",
      "system/fvSchemes 中 gradSchemes/default 取 Gauss linear。",
      "system/fvSchemes 中 divSchemes/default 取 none。",
      "system/fvSchemes 中 laplacianSchemes/default 取 Gauss linear corrected。"
    ],
    "run": [
      "先加载 OpenFOAM 环境；下列步骤从官方原始目录开始，按顺序准备网格、初始场并启动求解。步骤为：blockMesh → sonicLiquidFoam。checkMesh 可在网格生成后执行，foamToVTK -latestTime 可在求解完成后导出结果。"
    ]
  },
