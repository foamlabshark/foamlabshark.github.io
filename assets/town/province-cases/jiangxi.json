  "statement": {
    "physical": [
      "江西景德镇的陶瓷制作离不开瓷泥与浆料，不同剪切状态下的流动阻力会影响成形和混合。用偏心圆柱构造宽窄不一的间隙，可以在同一模型中形成不同的剪切速率。本关借此研究非牛顿流体的黏度变化。"
    ],
    "geometry": [
      "1,800 个单元。网格由本页原始文件和运行步骤生成，所有长度使用 SI 米。",
      "在示意图中核对边界名称；初始化文件和附带几何可在完整原始目录中查看。",
      "网格外包络沿 x、y、z 的长度依次为 10 × 4 × 2 m。点击图可放大查看实际 patch 名称及位置；同一边界可包含多处面。"
    ],
    "properties": [
      "constant/transportProperties 中 transportModel 取 CrossPowerLaw。",
      "constant/transportProperties 中 CrossPowerLawCoeffs/nu0 取 0.01 m²/s。",
      "constant/transportProperties 中 CrossPowerLawCoeffs/nuInf 取 10 m²/s。",
      "constant/transportProperties 中 CrossPowerLawCoeffs/m 取 0.4。",
      "constant/transportProperties 中 CrossPowerLawCoeffs/n 取 3。"
    ],
    "boundary": [
      "0/U 中的场为速度，单位 m/s；填写七个基本量纲指数。",
      "0/U 的初始内部场均匀，数值为 (0, 0, 0)（采用该场的 SI 单位）。",
      "0/U 这一段对应的网格边界名是 left；从示意图的边界分组中选择，保持大小写一致。",
      "0/p 中的场为运动学压力，单位 m²/s²；填写七个基本量纲指数。",
      "0/p 的初始内部场均匀，数值为 0（采用该场的 SI 单位）。"
    ],
    "control": [
      "求解器使用 nonNewtonianIcoFoam。",
      "终止时间/迭代编号为 2。",
      "初始时间步（稳态求解时为迭代步长）为 0.0025。"
    ],
    "numerics": [
      "system/fvSchemes 中 ddtSchemes/default 取 Euler。",
      "system/fvSchemes 中 gradSchemes/default 取 Gauss linear。",
      "system/fvSchemes 中 divSchemes/default 取 none。",
      "system/fvSchemes 中 laplacianSchemes/default 取 Gauss linear corrected。"
    ],
    "run": [
      "先加载 OpenFOAM 环境；下列步骤从官方原始目录开始，按顺序准备网格、初始场并启动求解。步骤为：blockMesh → nonNewtonianIcoFoam。checkMesh 可在网格生成后执行，foamToVTK -latestTime 可在求解完成后导出结果。"
    ]
  },
