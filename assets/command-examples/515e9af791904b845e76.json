[{"title":"下载日志","code":"scp student@compute.example.org:~/cases/caseA/log.icoFoam ./remote-icoFoam.log","explanation":"将日志下载并改名，保留远端文件。"},{"title":"上传目录","code":"scp -r caseA student@compute.example.org:~/cases/","explanation":"-r 递归复制完整算例。"},{"title":"指定服务端口","code":"scp -P 2222 caseA/system/fvSchemes student@compute.example.org:~/cases/caseA/system/","explanation":"scp 用大写 -P 指定端口。"},{"title":"下载两份报告","code":"scp student@compute.example.org:~/cases/caseA/log.blockMesh student@compute.example.org:~/cases/caseA/log.checkMesh ./","explanation":"多个源文件后跟一个目标目录，复制两份独立日志。"}]