[{"title":"生成 shell 设置","code":"\"$WM_PROJECT_DIR/bin/tools/foamCreateModuleInclude\" -sh -output=ModuleInclude.sh \"$WM_PROJECT_DIR\"","explanation":"-sh 输出 shell 格式，可供脚本检查或加载。"},{"title":"加载指定偏好文件","code":"\"$WM_PROJECT_DIR/bin/tools/foamCreateModuleInclude\" -prefs=\"$HOME/.OpenFOAM/prefs.sh\" -output=ModulePrefs.tcl \"$WM_PROJECT_DIR\"","explanation":"使用已经准备好的偏好文件生成相应编译配置。"},{"title":"保留 ParaView 环境","code":"\"$WM_PROJECT_DIR/bin/tools/foamCreateModuleInclude\" -paraview -output=ModuleParaView.tcl \"$WM_PROJECT_DIR\"","explanation":"让片段包含 ParaView 相关路径设置。"},{"title":"指定构建临时目录","code":"mkdir -p module-tmp\n\"$WM_PROJECT_DIR/bin/tools/foamCreateModuleInclude\" -tmpdir=\"$PWD/module-tmp\" -debug -output=ModuleDebug.tcl \"$WM_PROJECT_DIR\"","explanation":"使用独立临时目录，-debug 保留中间文件供比较环境变化。"}]