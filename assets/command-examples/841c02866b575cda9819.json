[{"title":"指定名称和输出目录","code":"mkdir -p releases\n\"$WM_PROJECT_DIR/bin/tools/foamPackRelease\" -name=foamlab-source -output=releases HEAD > pack-named.sh","explanation":"将包名主体和存放位置写入脚本。"},{"title":"只打包核心源码","code":"\"$WM_PROJECT_DIR/bin/tools/foamPackRelease\" -no-extras -name=core-only HEAD > pack-core.sh","explanation":"排除 modules/plugins 等附加内容。"},{"title":"选择压缩方式","code":"\"$WM_PROJECT_DIR/bin/tools/foamPackRelease\" -xz -name=source-xz HEAD > pack-xz.sh","explanation":"生成采用 xz 的打包脚本。"},{"title":"使用另一份仓库","code":"\"$WM_PROJECT_DIR/bin/tools/foamPackRelease\" -gitbase=\"$HOME/src/OpenFOAM-v2512\" -name=source-copy HEAD > pack-copy.sh\nbash pack-copy.sh","explanation":"输入目录必须是真实 Git 仓库；审核脚本后执行，生成该提交的源码包。"}]